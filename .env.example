# Copy this file to .env and fill in values as needed.
# All defaults below allow the platform to run fully offline with zero
# external credentials — only override a section if you're wiring up a
# real cloud provider.

# --- API ---
API_KEY=demo-local-key
SOURCE_DIR=data/sample_docs

# --- Providers (local defaults; require no credentials) ---
EMBEDDING_PROVIDER=local-hashing
VECTOR_STORE=numpy
LLM_PROVIDER=stub
CLOUD_PROVIDER=local

# --- Hybrid retrieval / agent tuning ---
HYBRID_ALPHA=0.6
AGENT_MAX_STEPS=6

# --- AWS (only if EMBEDDING_PROVIDER=bedrock / LLM_PROVIDER=bedrock / CLOUD_PROVIDER=aws) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=documind-ai-raw-docs

# --- Azure (only if *_PROVIDER=azure-openai / CLOUD_PROVIDER=azure) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=documind-ai-raw-docs

# --- GCP (only if *_PROVIDER=vertex-ai / CLOUD_PROVIDER=gcp) ---
GCP_PROJECT_ID=
GCP_REGION=us-central1
GCS_BUCKET=documind-ai-raw-docs

# --- OpenAI (only if *_PROVIDER=openai) ---
OPENAI_API_KEY=
